[Unit]
Description=SkillEdge S10 paper evaluation-only runner
After=network-online.target skilledge-stock-engine-api.service
Wants=network-online.target
Requires=skilledge-stock-engine-api.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/skilledge/stock-engine
ExecStart=/usr/bin/python3 /opt/skilledge/stock-engine/ops/scripts/s10_paper_evaluation_only_wrapper.py
TimeoutStartSec=120
Nice=5

[Install]
WantedBy=multi-user.target
